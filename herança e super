# 1. Classe Mãe (Superclasse)
class Funcionario:
    def __init__(self, nome, salario):
        # Atributos comuns que serão reaproveitados pelas classes filhas
        self.nome = nome
        self.salario = salario

    def exibir_dados(self):
        return f"Nome: {self.nome} | Salário: R$ {self.salario:.2f}"


# 2. Classe Filha (Subclasse) - Relação "Gerente é um Funcionario"
class Gerente(Funcionario):
    def __init__(self, nome, salario, departamento, senha_acesso):
        # Chamada ao construtor da classe mãe com super().__init__(...)[cite: 5]
        super().__init__(nome, salario)
        
        # Atributos específicos da classe filha
        self.departamento = departamento
        self.senha_acesso = senha_acesso

    # Reaproveitando e estendendo o método da classe mãe
    def exibir_dados(self):
        dados_base = super().exibir_dados()  # Reutiliza o código da mãe[cite: 5]
        return f"{dados_base} | Departamento: {self.departamento}"


# 3. Bloco de Demonstração
if __name__ == "__main__":
    print("--- Demonstração de Herança e super() ---")
    
    # Criando um objeto da classe filha
    gerente_1 = Gerente("Ana Souza", 9500.0, "Financeiro", "admin123")
    
    # Chamando o método que utiliza a herança e o super()
    print(gerente_1.exibir_dados())

# 4. Quarta Classe: Cliente
class Cliente:
    def __init__(self, nome, cpf, email):
        self.nome = nome
        self.cpf = cpf
        self._email = email

    @property
    def email(self):
        return self._email

    @email.setter
    def email(self, novo_email):
        if "@" not in novo_email or "." not in novo_email:
            raise ValueError("Formato de e-mail inválido.")
        self._email = novo_email

    def __str__(self):
        return f"Cliente: {self.nome} (E-mail: {self._email})"


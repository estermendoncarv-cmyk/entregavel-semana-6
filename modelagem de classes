from abc import ABC, abstractmethod

# 1. Classe Abstrata (Mãe)
class Conta(ABC):
    def __init__(self, numero, titular, saldo_inicial=0.0):
        self._numero = numero
        self._titular = titular
        self._saldo = saldo_inicial  # Encapsulado para validação posterior

    @property
    def saldo(self):
        return self._saldo

    @saldo.setter
    def saldo(self, valor):
        if valor < 0:
            raise ValueError("O saldo não pode ser negativo.")
        self._saldo = valor

    @abstractmethod
    def calcular_taxa_manutencao(self):
        pass
# 2. Classe Filha 1
class ContaCorrente(Conta):
    def __init__(self, numero, titular, saldo_inicial=0.0, limite=500.0):
        super().__init__(numero, titular, saldo_inicial)
        self.limite = limite

    # Sobrescrita de método (Polimorfismo)
    def calcular_taxa_manutencao(self):
        return 15.0


